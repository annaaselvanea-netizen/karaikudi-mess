# ==========================================
# Karaikudi Mess - POS Environment Variables
# ==========================================
# Copy this file to .env.local and replace the dummy values with your real configuration.

# ------------------------------------------
# 1. Firebase Configuration (Firestore & Auth)
# ------------------------------------------
# Obtain these from your Firebase Console (Project Settings -> General -> Your apps -> SDK setup/config)
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyDummyApiKeyForKaraikudiMess123456"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="karaikudi-mess-pos.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="karaikudi-mess-pos"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="karaikudi-mess-pos.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# ------------------------------------------
# 2. Google Sheets Synchronization
# ------------------------------------------
# Web App URL generated from Google Apps Script (see google-apps-script.js for setup instructions)
# Can also be configured directly in Restaurant Settings UI
GOOGLE_SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/AKfycbxDummyWebAppKeyExampleKaraikudiMessPOS/exec"

# ------------------------------------------
# 3. Next.js Optimizations
# ------------------------------------------
NEXT_TELEMETRY_DISABLED=1
