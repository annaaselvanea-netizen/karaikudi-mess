rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && (
        request.auth.token.role == role ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == role)
      );
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isCashier() {
      return hasRole('cashier');
    }

    function isStaff() {
      return hasRole('staff');
    }

    function isStaffOrAbove() {
      return isAuthenticated() && (isAdmin() || isCashier() || isStaff());
    }

    function isCashierOrAbove() {
      return isAuthenticated() && (isAdmin() || isCashier());
    }

    // --- Users Collection ---
    // Admins manage all user profiles; authenticated users can read their own profile
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    // --- Menu Items Collection ---
    // Anyone authenticated (or cashier/staff POS terminal) can read menu; only Admin can edit
    match /menuItems/{itemId} {
      allow read: if true; // POS and digital menus need instant read
      allow write: if isAdmin();
    }

    // --- Categories Collection ---
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Orders Collection ---
    // Staff & Cashiers & Admin can read orders
    // Cashier and Admin can create orders
    // Staff, Cashier, Admin can update status of orders
    match /orders/{orderId} {
      allow read: if isStaffOrAbove();
      allow create: if isCashierOrAbove();
      allow update: if isStaffOrAbove();
      allow delete: if isAdmin();
    }

    // --- Bills Collection ---
    // Cashier and Admin create bills; Admin can delete/void
    match /bills/{billId} {
      allow read: if isCashierOrAbove();
      allow create: if isCashierOrAbove();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- Expenses Collection ---
    // Admin only manages business expenses
    match /expenses/{expenseId} {
      allow read, write: if isAdmin();
    }

    // --- Daily Reports Collection ---
    // Cashier and Admin can read; Admin writes daily totals
    match /dailyReports/{reportId} {
      allow read: if isCashierOrAbove();
      allow write: if isAdmin();
    }

    // --- Settings Collection ---
    // Restaurant profile, tax info, printer settings: readable by staff/cashier, editable by Admin
    match /settings/{settingId} {
      allow read: if isStaffOrAbove();
      allow write: if isAdmin();
    }

    // --- Google Sheets Sync Logs ---
    // Automated sync logs
    match /syncLogs/{logId} {
      allow read: if isAdmin();
      allow write: if isCashierOrAbove();
    }
  }
}
